[Unit]
Description=Shuri Ollama Gemma 4 MoE inference

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/home/prakash/ai/ollama-models
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_KEEP_ALIVE=0
Environment=OLLAMA_VULKAN=1
Environment=OLLAMA_IGPU_ENABLE=1
ExecStart=/home/prakash/ai/ollama-v0.34.4/bin/ollama serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
