<script>
  import { glossaryById } from "../../data/ai-glossary.mjs";

  function setupGlossary() {
    if (document.getElementById("ai-term-definition")) return;
    const anchors = document.querySelectorAll<HTMLAnchorElement>('.prose-post a[href^="/ai/glossary/#"]');
    if (!anchors.length) return;
    let current: HTMLAnchorElement | undefined;
    const tip = document.createElement("div");
    tip.id = "ai-term-definition";
    tip.className = "ai-term-tooltip";
    tip.setAttribute("role", "tooltip");
    tip.hidden = true;
    document.body.appendChild(tip);
    const controller = new AbortController();
    const signal = controller.signal;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    const hide = () => {
      clearTimeout(hideTimer);
      if (current) {
        const ids = (current.getAttribute("aria-describedby") ?? "").split(" ").filter(id => id !== tip.id && id);
        if (ids.length) current.setAttribute("aria-describedby", ids.join(" "));
        else current.removeAttribute("aria-describedby");
      }
      current = undefined;
      tip.hidden = true;
    };
    const hideAfterPointerExit = () => {
      if (document.activeElement === current) return;
      const delay = getComputedStyle(document.documentElement).getPropertyValue("--dur-fast").trim();
      hideTimer = setTimeout(hide, parseFloat(delay) * (delay.endsWith("ms") ? 1 : 1000));
    };
    const position = () => {
      if (!current) return;
      const box = current.getBoundingClientRect();
      const gap = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--space-2"));
      const bounds = tip.getBoundingClientRect();
      tip.style.left = `${Math.max(gap, Math.min(box.left, innerWidth - bounds.width - gap))}px`;
      tip.style.top = `${Math.max(gap, box.bottom + bounds.height + gap > innerHeight ? box.top - bounds.height - gap : box.bottom + gap)}px`;
    };
    for (const anchor of anchors) {
      const entry = glossaryById[anchor.hash.slice(1)];
      if (!entry) continue;
      anchor.classList.add("ai-term-link");
      const show = () => {
        hide();
        current = anchor;
        tip.textContent = entry.definition;
        tip.hidden = false;
        anchor.setAttribute("aria-describedby", [anchor.getAttribute("aria-describedby"), tip.id].filter(Boolean).join(" "));
        position();
      };
      anchor.addEventListener("pointerenter", event => { if (event.pointerType !== "touch") show(); }, { signal });
      anchor.addEventListener("focus", show, { signal });
      anchor.addEventListener("pointerleave", event => {
        if (event.relatedTarget !== tip) hideAfterPointerExit();
      }, { signal });
      anchor.addEventListener("blur", hide, { signal });
    }
    tip.addEventListener("pointerenter", () => clearTimeout(hideTimer), { signal });
    tip.addEventListener("pointerleave", hideAfterPointerExit, { signal });
    document.addEventListener("keydown", event => { if (event.key === "Escape") hide(); }, { signal });
    window.addEventListener("scroll", () => {
      if (current && document.activeElement === current) position();
      else hide();
    }, { signal, passive: true });
    window.addEventListener("resize", hide, { signal });
    document.addEventListener("astro:before-swap", () => { hide(); tip.remove(); controller.abort(); }, { once: true });
  }
  setupGlossary();
  document.addEventListener("astro:page-load", setupGlossary);
</script>

<style is:global>
  .prose-post a.ai-term-link { text-decoration-style: dotted; text-underline-offset: 0.2em; }
  .ai-term-tooltip {
    position: fixed;
    z-index: 100;
    width: min(24rem, calc(100vw - var(--space-8)));
    padding: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    box-shadow: var(--shadow-lg);
    font-size: 1rem;
    line-height: 1.6;
  }
  .ai-term-tooltip[hidden] { display: none; }
</style>
