---
import type { GetStaticPaths } from "astro";
import AudioStartHere from "~/components/blog/AudioStartHere.astro";
import MusicShowcase from "~/components/blog/MusicShowcase.astro";
import MusicStackFlow from "~/components/blog/MusicStackFlow.astro";
import SiteShell from "~/layouts/SiteShell.astro";
import ScrollReveal from "~/components/motion/ScrollReveal.astro";
import { seriesRegistry, seriesCompanions, AUDIO_START_HERE_HREF } from "~/data/series";
import {
  getSeriesPosts,
  postUrl,
  postThumbnail,
  estimateReadMinutes,
  type Post,
} from "~/utils/posts";
import { formatBlogDate } from "~/utils";
import PodcastPlayer from "~/components/blog/PodcastPlayer.astro";
import { podcastEpisodes } from "~/data/podcast";

export const getStaticPaths = (async () => {
  const entries = await Promise.all(
    Object.entries(seriesRegistry).map(async ([slug, meta]) => ({
      slug, meta, parts: await getSeriesPosts(slug),
    })),
  );
  return entries.filter(({ parts }) => parts.length > 0).map(({ slug, meta }) => ({
    params: { slug }, props: { slug, meta },
  }));
}) satisfies GetStaticPaths;

const { slug, meta } = Astro.props as {
  slug: string;
  meta: { title: string; description: string; cover: string };
};

const parts: Post[] = await getSeriesPosts(slug);
const first = parts[0];
const seriesEpisodes = podcastEpisodes
  .filter((ep) => ep.series === slug)
  .sort((a, b) => a.order - b.order);
const cover = meta.cover;
const firstDate = first ? formatBlogDate(first.data.date) : "";
const partWord = parts.length === 1 ? "part" : "parts";
const pad = (n: number) => String(n).padStart(2, "0");
const companionSlug = seriesCompanions[slug];
const showAudioStartHere = slug === "homelab-music" || slug === "pocket-hi-fi";
// The start-here card already links part 1 on the music series; skip the duplicate hero button.
const heroStartsWithCard = showAudioStartHere && first && postUrl(first) === AUDIO_START_HERE_HREF;
const companion = companionSlug && (await getSeriesPosts(companionSlug)).length > 0
  ? { slug: companionSlug, ...seriesRegistry[companionSlug] } : undefined;
---

<SiteShell title={`${meta.title} · Series`} description={meta.description}>
  <section class="bg-surface-base pt-40 pb-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-12 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-3">Series</p>
        <h1 class="text-display-lg text-strong">{meta.title}</h1>
        <p class="mt-5 text-body-lg text-muted max-w-reading">{meta.description}</p>
        {showAudioStartHere && <AudioStartHere />}
        {companion && (
          <p class="mt-4 text-body text-muted">
            Continue exploring: <a class="underline" href={`/series/${companion.slug}/`}>{companion.title}</a>.
          </p>
        )}
        {parts.length > 0 && (
          <p class="mt-4 text-caption text-faint">
            {parts.length} {partWord}
            {firstDate && <> · first published <time datetime={new Date(first.data.date).toISOString()}>{firstDate}</time></>}
          </p>
        )}
        {first && !heroStartsWithCard && (
          <div class="mt-8">
            <a href={postUrl(first)} class="btn btn-primary">
              <span>Start with part 1 →</span>
            </a>
          </div>
        )}
      </div>
      {cover && (
        <figure class="lg:col-span-5 aspect-[21/9] lg:aspect-video overflow-hidden rounded-xl bg-ink-100 shadow-md">
          <img src={cover} alt={meta.title} class="h-full w-full object-cover" />
        </figure>
      )}
    </div>
  </section>

  {slug === "homelab-music" && <MusicShowcase />}
  {slug === "homelab-music" && <MusicStackFlow />}

  {seriesEpisodes.length > 0 && (
    <section class="pb-4">
      <div class="mx-auto max-w-4xl px-6 lg:px-12">
        <div class="flex items-baseline justify-between gap-4 mb-6 flex-wrap">
          <h2 class="text-h3 text-strong">Listen along</h2>
          <a href={`/podcast/${slug}/feed.xml`} class="link-underline text-caption text-muted">
            Subscribe (RSS)
          </a>
        </div>
        <div class="space-y-4">
          {seriesEpisodes.map((ep, i) => (
            <ScrollReveal delay={60 * i}>
              <PodcastPlayer episode={ep} />
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class={slug === "homelab-music" ? "pt-20 pb-24" : "pb-24"}>
    <div class="mx-auto max-w-7xl px-6 lg:px-12">
      {parts.length === 0 ? (
        <p class="text-muted">No parts published yet.</p>
      ) : (
        <ol class="list-none grid grid-cols-1 gap-4 max-w-4xl">
          {parts.map((post, i) => {
            const minutes = estimateReadMinutes(post.body);
            return (
              <ScrollReveal delay={Math.min(i, 4) * 40} as="li">
                <a
                  href={postUrl(post)}
                  class="card-interactive group flex flex-col gap-6 bg-surface-raised rounded-lg p-6 md:flex-row lg:p-8"
                >
                  <div class="aspect-[16/10] w-full shrink-0 self-start overflow-hidden rounded-md md:order-last md:w-56">
                    <img
                      src={postThumbnail(post)}
                      alt=""
                      width="448"
                      height="280"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-[var(--dur-normal)] motion-safe:ease-[var(--ease-out-expo)] motion-safe:group-hover:scale-[1.03]"
                    />
                  </div>
                  <div class="grid min-w-0 flex-1 grid-cols-[auto_minmax(0,1fr)] gap-6 items-start">
                    <span class="text-h1 font-bold text-accent-700 leading-none">{pad(i + 1)}</span>
                    <div class="min-w-0 break-words">
                      <h2 class="text-h3 text-strong group-hover:text-accent-700 transition-colors">
                        {post.data.title}
                      </h2>
                      {post.data.excerpt && (
                        <p class="mt-3 text-body text-muted line-clamp-3 max-w-reading">{post.data.excerpt}</p>
                      )}
                      <div class="mt-4 flex flex-wrap items-center gap-3 text-caption text-muted">
                        <time datetime={new Date(post.data.date).toISOString()}>
                          {formatBlogDate(post.data.date)}
                        </time>
                        <span class="text-faint">·</span>
                        <span>{minutes} min read</span>
                      </div>
                    </div>
                  </div>
                </a>
              </ScrollReveal>
            );
          })}
        </ol>
      )}

      {first && parts.length > 1 && (
        <div class="mt-12 flex justify-center">
          <a href={postUrl(first)} class="btn btn-primary">
            <span>Start with part 1 →</span>
          </a>
        </div>
      )}
    </div>
  </section>
</SiteShell>
