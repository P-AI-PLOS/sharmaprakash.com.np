---
import SiteShell from "~/layouts/SiteShell.astro";
import ScrollReveal from "~/components/motion/ScrollReveal.astro";
import StatuslinePlayground from "~/components/tools/statusline-playground/StatuslinePlayground";
---
<SiteShell title="Claude Code Statusline Playground — Free Tool" description="Build and preview a one-row or three-row Claude Code statusline with context, cost, rate limits, pull requests, CI, worktrees, and project state, then export a working Bash script and settings.json block.">
  <section class="bg-surface-base pt-40 pb-12"><ScrollReveal class="mx-auto max-w-3xl px-6 lg:px-12 text-center"><p class="eyebrow mb-3">Free tool</p><h1 class="text-display-lg text-strong">Claude Code Statusline Playground</h1><p class="mt-4 text-body-lg text-muted max-w-xl mx-auto">Start with the <a href="/ai/statusline-the-five-second-feedback-loop/" class="link-underline text-accent-700">one-row feedback loop</a> or build the <a href="/ai/statusline-v2-three-rows-live-project-hud/" class="link-underline text-accent-700">three-row live project HUD</a>. Test every signal with sample data, read how its source works, and export the matching script.</p></ScrollReveal></section>
  <section class="bg-surface-base pb-24"><div class="mx-auto max-w-5xl px-6 lg:px-12"><StatuslinePlayground client:load /></div></section>
</SiteShell>
